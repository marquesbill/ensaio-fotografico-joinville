{
  "functions": {
    "api/webhook.ts": { "maxDuration": 60 },
    "api/admin-bookings.ts": { "maxDuration": 30 },
    "api/videos-checkout.ts": { "maxDuration": 60 },
    "api/send-guia.ts": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    {
      "source": "/r2/:path*",
      "destination": "https://pub-144050c98b964bdc95d46793863feff0.r2.dev/:path*"
    },
    { "source": "/(.*)",     "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
